local number = 13
match number
    -- Match a single value
    1 => do
      local str = "One!"
      print(str)

      return
    end,
    -- Match several values
    2 or 3 or 5 or 7 or 11 => print("This is a prime"),
    -- Match an inclusive range
    13, 19 => print("A teen"),
    -- Handle the rest of cases
    _ => print("Ain't special")
end






local pair = true
match pair
  (x, y) if x == y => print("These are twins"),
  (x, y) if x + y == 0 => print("Antimatter, kaboom!"),
  -- { 2, 3 } => print("ok"),
  _ => print("No correlation...")
end